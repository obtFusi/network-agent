# LDAP Seed Data for Pentest Lab
# Domain: lab.local (dc=lab,dc=local)

# Organizational Units
dn: ou=People,dc=lab,dc=local
objectClass: organizationalUnit
ou: People

dn: ou=Groups,dc=lab,dc=local
objectClass: organizationalUnit
ou: Groups

dn: ou=Servers,dc=lab,dc=local
objectClass: organizationalUnit
ou: Servers

dn: ou=Service Accounts,dc=lab,dc=local
objectClass: organizationalUnit
ou: Service Accounts

# Users
dn: cn=John Doe,ou=People,dc=lab,dc=local
objectClass: inetOrgPerson
cn: John Doe
sn: Doe
givenName: John
uid: jdoe
mail: jdoe@lab.local
userPassword: password123

dn: cn=Jane Admin,ou=People,dc=lab,dc=local
objectClass: inetOrgPerson
cn: Jane Admin
sn: Admin
givenName: Jane
uid: jadmin
mail: jadmin@lab.local
userPassword: admin456

dn: cn=Bob User,ou=People,dc=lab,dc=local
objectClass: inetOrgPerson
cn: Bob User
sn: User
givenName: Bob
uid: buser
mail: buser@lab.local
userPassword: bob789

# Service Accounts
dn: cn=svc-backup,ou=Service Accounts,dc=lab,dc=local
objectClass: inetOrgPerson
cn: svc-backup
sn: Backup Service
uid: svc-backup
userPassword: backup2024

dn: cn=svc-monitoring,ou=Service Accounts,dc=lab,dc=local
objectClass: inetOrgPerson
cn: svc-monitoring
sn: Monitoring Service
uid: svc-monitoring
userPassword: monitor2024

# Groups
dn: cn=Domain Admins,ou=Groups,dc=lab,dc=local
objectClass: groupOfNames
cn: Domain Admins
member: cn=Jane Admin,ou=People,dc=lab,dc=local

dn: cn=Users,ou=Groups,dc=lab,dc=local
objectClass: groupOfNames
cn: Users
member: cn=John Doe,ou=People,dc=lab,dc=local
member: cn=Bob User,ou=People,dc=lab,dc=local

dn: cn=IT Operations,ou=Groups,dc=lab,dc=local
objectClass: groupOfNames
cn: IT Operations
member: cn=Jane Admin,ou=People,dc=lab,dc=local
member: cn=svc-backup,ou=Service Accounts,dc=lab,dc=local
member: cn=svc-monitoring,ou=Service Accounts,dc=lab,dc=local

# Server Objects
dn: cn=dc01,ou=Servers,dc=lab,dc=local
objectClass: device
cn: dc01
description: Primary Domain Controller

dn: cn=fileserver,ou=Servers,dc=lab,dc=local
objectClass: device
cn: fileserver
description: File Server with SMB shares
