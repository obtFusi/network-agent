# API Key für deinen LLM Provider
# Funktioniert mit jeder OpenAI-kompatiblen API
LLM_API_KEY=your_api_key_here

# SearXNG Secret (auto-generate with: openssl rand -base64 32)
SEARXNG_SECRET=generate_a_random_secret_here

# Local telemetry report storage. Supply the credential values from a private file.
MINIO_ENDPOINT=https://telemetry-storage.example.invalid
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
