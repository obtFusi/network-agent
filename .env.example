# API Key für deinen LLM Provider
# Funktioniert mit jeder OpenAI-kompatiblen API
LLM_API_KEY=your_api_key_here

# SearXNG Secret (auto-generate with: openssl rand -base64 32)
SEARXNG_SECRET=generate_a_random_secret_here

# Local telemetry report storage. Supply the credential values from a private file.
MINIO_ENDPOINT=https://telemetry-storage.example.invalid
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Optional operator settings for the local build telemetry scripts.
# Keep the actual SSH alias in your private environment or SSH configuration.
# NETWORK_AGENT_BUILD_SSH_TARGET=build-host
# NETWORK_AGENT_BUILD_STATUS_FILE=/var/lib/network-agent/build-status.json

# Required when provisioning a runner container on Proxmox.
# NETWORK_AGENT_RUNNER_HOSTNAME=build-runner.example.invalid
# NETWORK_AGENT_RUNNER_VMID=<free container ID>
